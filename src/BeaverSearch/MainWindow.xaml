<Window x:Class="BeaverSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BeaverSearch.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="BeaverSearch" Height="941" Width="1672" MinHeight="760" MinWidth="1280"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" BorderThickness="0" Opacity="1" PreviewMouseWheel="Window_PreviewMouseWheel">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootShell" BorderThickness="0" Background="{StaticResource BgBrush}" SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource SidebarBrush}" BorderBrush="#24292E" BorderThickness="0,0,1,0">
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="143"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="318"/>
                    </Grid.RowDefinitions>

                    <!-- hamburger -->
                    <Grid Grid.Row="0" Margin="17,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="24" Height="20">
                        <Rectangle Height="1" Fill="#CCD2D8" VerticalAlignment="Top" Margin="2,3,2,0" RadiusX="1"/>
                        <Rectangle Height="1" Fill="#CCD2D8" VerticalAlignment="Center" Margin="2,0" RadiusX="1"/>
                        <Rectangle Height="1" Fill="#CCD2D8" VerticalAlignment="Bottom" Margin="2,0,2,3" RadiusX="1"/>
                    </Grid>

                    <!-- exact brand crop from the approved visual system, cleaned to transparent PNG -->
                    <Grid Grid.Row="1" Margin="18,0,18,4">
                        <Image Source="/Assets/Brand/sidebar_brand_transparent.png" Width="202" Height="136" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- navigation -->
                    <StackPanel Grid.Row="2" Margin="0,4,0,0">
                        <RadioButton x:Name="NavMonitor" Style="{StaticResource NavRadio}" GroupName="Nav" Content="Мониторинг" IsChecked="True" Click="Navigate_Click" CommandParameter="0" Tag="M3,12 H7 L10,4 L14,20 L17,12 H21"/>
                        <RadioButton x:Name="NavServers" Style="{StaticResource NavRadio}" GroupName="Nav" Content="Серверы" Click="Navigate_Click" CommandParameter="1" Tag="M4,4 H20 V9 H4 Z M4,15 H20 V20 H4 Z M7,6.5 H7.01 M7,17.5 H7.01"/>
                        <RadioButton x:Name="NavResults" Style="{StaticResource NavRadio}" GroupName="Nav" Content="Результаты" Click="Navigate_Click" CommandParameter="2" Tag="M6,3 H15 L20,8 V21 H6 Z M15,3 V8 H20 M9,12 H17 M9,16 H17"/>
                        <RadioButton x:Name="NavDiagnostics" Style="{StaticResource NavRadio}" GroupName="Nav" Content="Диагностика" Click="Navigate_Click" CommandParameter="3" Tag="M4,20 V14 M10,20 V10 M16,20 V6 M22,20 V3"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavRadio}" GroupName="Nav" Content="Настройки" Click="Navigate_Click" CommandParameter="4" Tag="M4,21 V14 M4,10 V3 M12,21 V12 M12,8 V3 M20,21 V16 M20,12 V3 M1,14 H7 M9,8 H15 M17,16 H23"/>
                    </StackPanel>

                    <!-- approved lower sidebar illustration -->
                    <Grid Grid.Row="4" VerticalAlignment="Bottom" ClipToBounds="True">
                        <Image Source="/Assets/Sidebar/beaver_scene.png" Stretch="UniformToFill" Width="252" Height="310" VerticalAlignment="Bottom" Opacity="0.96"/>
                        <Rectangle VerticalAlignment="Top" Height="72">
                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF101315" Offset="0"/><GradientStop Color="#00101315" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                        </Rectangle>
                        <StackPanel VerticalAlignment="Bottom" Margin="29,0,0,18">
                            <TextBlock Text="БОЛЬШЕ" Foreground="#8B939C" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock Text="ЧЕМ ПОИСК" Foreground="#8B939C" FontSize="10" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            <TextBlock Text="v0.4.1 FixSteamID" Foreground="#6E767F" FontSize="10" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- custom title bar; no OS white top border -->
            <Border Grid.Column="1" Grid.Row="0" Background="#0D0E10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleButton}" Content="—" Click="Minimize_Click" FontSize="14"/>
                        <Button Style="{StaticResource TitleButton}" Click="Maximize_Click">
                            <Border Width="10" Height="9" BorderBrush="#BBC2C9" BorderThickness="1" Background="Transparent"/>
                        </Button>
                        <Button Style="{StaticResource CloseTitleButton}" Content="×" Click="Close_Click" FontSize="18"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- page host -->
            <TabControl x:Name="MainTabs" Grid.Column="1" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectedIndex="0" SelectionChanged="MainTabs_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl"><Border Background="Transparent"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border></ControlTemplate>
                </TabControl.Template>
                <TabItem><views:MonitorView/></TabItem>
                <TabItem><views:ServersView/></TabItem>
                <TabItem><views:ResultsView/></TabItem>
                <TabItem><views:DiagnosticsView/></TabItem>
                <TabItem><views:SettingsView/></TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
