<UserControl x:Class="BeaverSearch.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             PreviewMouseWheel="Page_PreviewMouseWheel">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <Grid Margin="24,12,24,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Border Width="4" Height="31" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,3,16,0"/><TextBlock Style="{StaticResource PageTitle}" Text="Найденные результаты"/></StackPanel><TextBlock Style="{StaticResource PageSubtitle}" Margin="20,2,0,0" Text="Игроки, соответствующие заданным критериям, и стоимость их инвентарей"/></StackPanel><Border Grid.Column="1" Style="{StaticResource StatusChip}" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding MonitoringStateText}" Foreground="#72E8AA" FontWeight="SemiBold" FontSize="12"/></StackPanel></Border><Button Grid.Column="3" Style="{StaticResource OutlineAccentButton}" Command="{Binding ExportCommand}" Padding="18,10"><StackPanel Orientation="Horizontal"><Path Data="M12,3 L12,16 M7,11 L12,16 L17,11 M4,19 L20,19 L20,22 L4,22 Z" Style="{StaticResource AccentLineIcon}" Width="17" Height="17" Margin="0,0,9,0"/><TextBlock Text="Экспорт в Excel"/></StackPanel></Button></Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="13" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="12"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><Grid Grid.Column="0"><TextBox x:Name="ResultsSearchBox" Tag="Поиск по нику или SteamID…" Padding="34,8,11,8" TextChanged="ResultsSearchBox_TextChanged"/><Path Data="M10,3 A7,7 0 1 1 9.99,3 M15,15 L21,21" Style="{StaticResource LineIcon}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/></Grid><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Style="{StaticResource InnerCard}" Padding="9,5" Margin="0,0,7,0"><StackPanel Orientation="Horizontal"><Image Source="/Assets/Games/cs2.png" Width="22" Height="22"/><TextBlock Text="CS2" Margin="6,2,0,0"/></StackPanel></Border><Border Style="{StaticResource InnerCard}" Padding="9,5" Margin="0,0,7,0"><StackPanel Orientation="Horizontal"><Image Source="/Assets/Games/dota2.png" Width="22" Height="22"/><TextBlock Text="Dota 2" Margin="6,2,0,0"/></StackPanel></Border><Border Style="{StaticResource InnerCard}" Padding="9,5"><StackPanel Orientation="Horizontal"><Image Source="/Assets/Games/rust.png" Width="22" Height="22"/><TextBlock Text="Rust" Margin="6,2,0,0"/></StackPanel></Border></StackPanel><Border Grid.Column="4" Background="#101316" BorderBrush="#343A42" BorderThickness="1" CornerRadius="6" Padding="11,0"><TextBlock Text="По итоговой стоимости ↓" VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}"/></Border><Border Grid.Column="6" Background="#101316" BorderBrush="#343A42" BorderThickness="1" CornerRadius="6" Padding="11,0"><TextBlock Text="За всё время" VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}"/></Border></Grid></Border>
            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12"><Border Style="{StaticResource Card}" Margin="0,0,10,0" Height="92"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}" Width="42" Height="42"><Path Data="M8,11 A4,4 0 1 1 8,3 A4,4 0 1 1 8,11 M2,21 C2,16 5,13 9,13 C13,13 16,16 16,21" Style="{StaticResource AccentLineIcon}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource SmallLabel}" Text="Всего совпадений"/><TextBlock Text="{Binding MatchCount}" FontSize="27" FontWeight="Bold" Margin="0,2,0,0"/></StackPanel></Grid></Border><Border Style="{StaticResource Card}" Margin="0,0,10,0" Height="92"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}" Width="42" Height="42"><Path Data="M8,11 A4,4 0 1 1 8,3 A4,4 0 1 1 8,11 M2,21 C2,16 5,13 9,13 C13,13 16,16 16,21 M16,8 A3,3 0 1 1 16,2" Style="{StaticResource AccentLineIcon}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource SmallLabel}" Text="Уникальных игроков"/><TextBlock Text="{Binding UniquePlayers}" FontSize="27" FontWeight="Bold" Margin="0,2,0,0"/></StackPanel></Grid></Border><Border Style="{StaticResource Card}" Margin="0,0,10,0" Height="92"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}" Width="42" Height="42"><Path Data="M4,8 C4,5 8,3 12,3 C16,3 20,5 20,8 C20,11 16,13 12,13 C8,13 4,11 4,8 Z M4,8 L4,16 C4,19 8,21 12,21 C16,21 20,19 20,16 L20,8 M4,12 C4,15 8,17 12,17 C16,17 20,15 20,12" Style="{StaticResource AccentLineIcon}" Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource SmallLabel}" Text="Средняя стоимость"/><TextBlock Text="{Binding AverageResultValue, StringFormat={}{0:N0} ₽}" FontSize="24" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Grid></Border><Border Style="{StaticResource Card}" Height="92"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}" Width="42" Height="42"><Path Data="M4,7 L8,11 L12,4 L16,11 L20,7 L18,19 L6,19 Z" Style="{StaticResource AccentLineIcon}" Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource SmallLabel}" Text="Наивысший итог"/><TextBlock Text="{Binding HighestResultValue, StringFormat={}{0:N0} ₽}" FontSize="24" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock Text="{Binding HighestResultNickname}" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Grid></Border></UniformGrid>
            <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="282"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" MinHeight="560"><Grid><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions><Grid Margin="15,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M8,11 A4,4 0 1 1 8,3 A4,4 0 1 1 8,11 M2,21 C2,16 5,13 9,13 C13,13 16,16 16,21" Style="{StaticResource AccentLineIcon}" Width="18" Height="18" Margin="0,0,9,0"/><TextBlock Style="{StaticResource SectionTitle}" Text="Результаты поиска"/><TextBlock Text="{Binding MatchCount, StringFormat=' ({0})'}" Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/></StackPanel></Grid><DataGrid x:Name="ResultsGrid" Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" IsReadOnly="True"><DataGrid.Columns><DataGridTemplateColumn Header="Игрок" Width="1.35*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="15" Background="#262B31"><Image Source="{Binding AvatarUrl}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Nickname}" FontWeight="SemiBold"/><TextBlock Text="Steam" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="SteamID64" Binding="{Binding SteamId64}" Width="145"/><DataGridTextColumn Header="CS2" Binding="{Binding Cs2Rub, StringFormat={}{0:N0} ₽}" Width="78"/><DataGridTextColumn Header="Dota 2" Binding="{Binding DotaRub, StringFormat={}{0:N0} ₽}" Width="78"/><DataGridTextColumn Header="Rust" Binding="{Binding RustRub, StringFormat={}{0:N0} ₽}" Width="78"/><DataGridTextColumn Header="Итог" Binding="{Binding TotalRub, StringFormat={}{0:N0} ₽}" Width="88"/><DataGridTextColumn Header="Совпадение" Binding="{Binding MatchedBy}" Width="110"/><DataGridTextColumn Header="Сервер" Binding="{Binding Servers}" Width="1*"/><DataGridTextColumn Header="Проверка" Binding="{Binding LastCheckedUtc, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="128"/></DataGrid.Columns></DataGrid><Grid Grid.Row="2" Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Один SteamID отображается один раз" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding ClearResultsCommand}" Content="Очистить" Padding="12,6"/><Button Grid.Column="3" Style="{StaticResource OutlineAccentButton}" Command="{Binding OpenSelectedSteamCommand}" Content="Открыть Steam" Padding="12,6"/></Grid></Grid></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" MinHeight="560"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Path Data="M8,11 A4,4 0 1 1 8,3 A4,4 0 1 1 8,11 M2,21 C2,16 5,13 9,13 C13,13 16,16 16,21" Style="{StaticResource AccentLineIcon}" Width="18" Height="18" Margin="0,0,9,0"/><TextBlock Style="{StaticResource SectionTitle}" Text="Информация об игроке"/></StackPanel><TextBlock Grid.Column="1" Text="×" Foreground="{StaticResource MutedBrush}" FontSize="18"/></Grid><Border Height="1" Background="#2A2F35" Margin="0,12,0,14"/><StackPanel Orientation="Horizontal"><Border Width="54" Height="54" CornerRadius="27" Background="#272C32"><Image Source="{Binding SelectedResult.AvatarUrl}" Stretch="UniformToFill"/></Border><StackPanel Margin="12,4,0,0"><TextBlock Text="{Binding SelectedResult.Nickname}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Steam" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel></StackPanel><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="SteamID64" Style="{StaticResource SmallLabel}"/><TextBlock Grid.Column="1" Text="{Binding SelectedResult.SteamId64}" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis"/></Grid><TextBlock Text="Итоговая стоимость" Style="{StaticResource SmallLabel}" Margin="0,18,0,3"/><TextBlock Text="{Binding SelectedResult.TotalRub, StringFormat={}{0:N0} ₽}" Foreground="{StaticResource AccentLightBrush}" FontWeight="Bold" FontSize="23"/><StackPanel Margin="0,12,0,0"><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image Source="/Assets/Games/cs2.png" Width="22" Height="22"/><TextBlock Text="CS2 инвентарь" Margin="7,2,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding SelectedResult.Cs2Rub, StringFormat={}{0:N0} ₽}" Foreground="{StaticResource AccentLightBrush}" FontWeight="SemiBold"/></Grid><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image Source="/Assets/Games/dota2.png" Width="22" Height="22"/><TextBlock Text="Dota 2 инвентарь" Margin="7,2,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding SelectedResult.DotaRub, StringFormat={}{0:N0} ₽}" Foreground="{StaticResource AccentLightBrush}" FontWeight="SemiBold"/></Grid><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image Source="/Assets/Games/rust.png" Width="22" Height="22"/><TextBlock Text="Rust инвентарь" Margin="7,2,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding SelectedResult.RustRub, StringFormat={}{0:N0} ₽}" Foreground="{StaticResource AccentLightBrush}" FontWeight="SemiBold"/></Grid></StackPanel><TextBlock Text="Совпадения" Style="{StaticResource SmallLabel}" Margin="0,18,0,5"/><TextBlock Text="{Binding SelectedResult.MatchedBy}" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap"/><TextBlock Text="Найден на серверах" Style="{StaticResource SmallLabel}" Margin="0,18,0,5"/><TextBlock Text="{Binding SelectedResult.Servers}" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" MaxHeight="64"/><StackPanel VerticalAlignment="Bottom" Margin="0,18,0,0"><Button Style="{StaticResource OutlineAccentButton}" Command="{Binding OpenSelectedSteamCommand}" Content="Открыть в Steam"/><Button Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Command="{Binding CopySelectedSteamCommand}" Content="Скопировать SteamID"/></StackPanel></StackPanel></Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
