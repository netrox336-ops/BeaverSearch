<UserControl x:Class="BeaverSearch.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             PreviewMouseWheel="Page_PreviewMouseWheel">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <Grid Margin="24,12,24,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><StackPanel Orientation="Horizontal"><Border Width="4" Height="31" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,3,16,0"/><TextBlock Style="{StaticResource PageTitle}" Text="Мониторинг серверов"/></StackPanel><TextBlock Style="{StaticResource PageSubtitle}" Margin="20,2,0,0" Text="Отслеживание игроков в реальном времени на выбранных серверах"/></StackPanel>
                <Button Grid.Column="1" Style="{StaticResource StatusChipButton}" Command="{Binding ToggleMonitoringCommand}" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Opacity" Value="0.9"/><Style.Triggers><DataTrigger Binding="{Binding IsMonitoring}" Value="True"><DataTrigger.EnterActions><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.85"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding MonitoringStateText}" Foreground="#72E8AA" FontWeight="SemiBold" FontSize="12"/></StackPanel></Button>
                <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="Сбор данных и анализ инвентарей" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right"/><TextBlock Text="{Binding StatusLine}" Foreground="#AEB5BD" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel>
            </Grid>
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Height="106"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><Path Data="M4,3 L20,3 L20,21 L4,21 Z M8,7 L16,7 M8,12 L16,12 M8,17 L13,17" Style="{StaticResource AccentLineIcon}" Width="20" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource SmallLabel}" Text="Серверов онлайн"/><TextBlock Style="{StaticResource MetricValue}" Text="{Binding ServerCountText}" Margin="0,3,0,0"/></StackPanel></Grid></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Height="106"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><Path Data="M8,11 A4,4 0 1 1 8,3 A4,4 0 1 1 8,11 M2,21 C2,16 5,13 9,13 C13,13 16,16 16,21 M17,8 A3,3 0 1 1 17,2 M17,13 C20,13 22,15 22,19" Style="{StaticResource AccentLineIcon}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource SmallLabel}" Text="Игроков онлайн"/><TextBlock Style="{StaticResource MetricValue}" Text="{Binding PlayersOnline}" Margin="0,3,0,0"/></StackPanel></Grid></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Height="106"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><Path Data="M6,3 L18,3 L20,5 L20,21 L4,21 L4,5 Z M8,8 L16,8 M8,12 L16,12 M8,16 L13,16" Style="{StaticResource AccentLineIcon}" Width="20" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource SmallLabel}" Text="Проверено сегодня"/><TextBlock Style="{StaticResource MetricValue}" Text="{Binding CheckedSession}" Margin="0,3,0,0"/></StackPanel></Grid></Border>
                <Border Style="{StaticResource Card}" Height="106"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><Path Data="M12,2 L12,6 M12,18 L12,22 M2,12 L6,12 M18,12 L22,12 M12,7 A5,5 0 1 1 12,17 A5,5 0 1 1 12,7" Style="{StaticResource AccentLineIcon}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource SmallLabel}" Text="Совпадений"/><TextBlock Style="{StaticResource MetricValue}" Text="{Binding MatchCount}" Margin="0,3,0,0"/></StackPanel></Grid></Border>
            </UniformGrid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.13*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition MinHeight="294" Height="Auto"/><RowDefinition Height="16"/><RowDefinition MinHeight="330" Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M3,4 L21,4 L21,9 L3,9 Z M3,11 L21,11 L21,16 L3,16 Z M3,18 L21,18 L21,23 L3,23 Z" Style="{StaticResource AccentLineIcon}" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Style="{StaticResource SectionTitle}" Text="Отслеживаемые серверы"/></StackPanel><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="OpenServers_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="15" Margin="0,-1,7,0"/><TextBlock Text="Каталог серверов"/></StackPanel></Button></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding Servers}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Сервер" Binding="{Binding Address}" Width="1.45*"/><DataGridTemplateColumn Header="Игра" Width="74"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="/Assets/Games/cs2.png" Width="23" Height="23" Margin="0,0,7,0"/><TextBlock Text="CS2" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Карта" Binding="{Binding Map}" Width="1*"/><DataGridTextColumn Header="Игроки" Binding="{Binding PlayerCountText}" Width="72"/><DataGridTextColumn Header="Пинг" Binding="{Binding PingText}" Width="68"/><DataGridTemplateColumn Header="Статус" Width="108"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,7,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource DangerBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Online}" Value="True"><Setter Property="Fill" Value="{StaticResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding Status}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></Border>
                <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Path Data="M3,4 L21,4 L14,12 L14,20 L10,22 L10,12 Z" Style="{StaticResource AccentLineIcon}" Width="20" Height="20" Margin="0,0,10,0"/><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Фильтры поиска игроков"/><TextBlock Text="Игрок проходит, если подходит хотя бы одна игра" Style="{StaticResource SmallLabel}" Margin="0,2,0,0"/></StackPanel></StackPanel><Border Grid.Column="1" Style="{StaticResource StatusChip}" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/><TextBlock Text="Автосохранение" Foreground="#72E8AA" FontSize="11"/></StackPanel></Border></Grid><UniformGrid Grid.Row="1" Columns="3" Margin="0,16,0,0"><Border Style="{StaticResource InnerCard}" Margin="0,0,10,0"><StackPanel><StackPanel Orientation="Horizontal"><Image Source="/Assets/Games/cs2.png" Width="38" Height="38" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="CS2" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Стоимость инвентаря" Style="{StaticResource SmallLabel}"/></StackPanel></StackPanel><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding Settings.Cs2Min, UpdateSourceTrigger=PropertyChanged}" Tag="От"/><TextBox Grid.Column="2" Text="{Binding Settings.Cs2Max, UpdateSourceTrigger=PropertyChanged}" Tag="До"/></Grid><TextBlock Text="₽  Диапазон CS2" Foreground="{StaticResource AccentLightBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource InnerCard}" Margin="0,0,10,0"><StackPanel><StackPanel Orientation="Horizontal"><Image Source="/Assets/Games/dota2.png" Width="38" Height="38" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Dota 2" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Стоимость инвентаря" Style="{StaticResource SmallLabel}"/></StackPanel></StackPanel><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding Settings.DotaMin, UpdateSourceTrigger=PropertyChanged}" Tag="От"/><TextBox Grid.Column="2" Text="{Binding Settings.DotaMax, UpdateSourceTrigger=PropertyChanged}" Tag="До"/></Grid><TextBlock Text="₽  Диапазон Dota 2" Foreground="{StaticResource AccentLightBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource InnerCard}"><StackPanel><StackPanel Orientation="Horizontal"><Image Source="/Assets/Games/rust.png" Width="38" Height="38" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Rust" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Стоимость инвентаря" Style="{StaticResource SmallLabel}"/></StackPanel></StackPanel><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding Settings.RustMin, UpdateSourceTrigger=PropertyChanged}" Tag="От"/><TextBox Grid.Column="2" Text="{Binding Settings.RustMax, UpdateSourceTrigger=PropertyChanged}" Tag="До"/></Grid><TextBlock Text="₽  Диапазон Rust" Foreground="{StaticResource AccentLightBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border></UniformGrid><TextBlock Grid.Row="2" Text="Изменения сохраняются автоматически и сразу используются Inventory Scanner. min/max всегда поддерживается в корректном порядке." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,12,0,0"/></Grid></Border>
                <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="16,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M12,2 A10,10 0 1 1 12,22 A10,10 0 1 1 12,2 M12,7 L12,12 L16,14" Style="{StaticResource AccentLineIcon}" Width="19" Height="19" Margin="0,0,10,0"/><TextBlock Style="{StaticResource SectionTitle}" Text="Последняя активность"/></StackPanel></Grid><ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Style="{StaticResource CleanListBox}" Foreground="#B9C0C7" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Padding="14,2"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="5,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#24292F"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style></ListBox.ItemContainerStyle></ListBox></Grid></Border>
                <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M8,11 A4,4 0 1 1 8,3 A4,4 0 1 1 8,11 M2,21 C2,16 5,13 9,13 C13,13 16,16 16,21 M17,8 A3,3 0 1 1 17,2" Style="{StaticResource AccentLineIcon}" Width="19" Height="19" Margin="0,0,10,0"/><TextBlock Style="{StaticResource SectionTitle}" Text="Найденные игроки"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding MatchCount, StringFormat='Всего: {0}'}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/></Grid><ListBox Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" Style="{StaticResource CleanListBox}"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#24292F" BorderThickness="0,0,0,1" Padding="14,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="18" Background="#252A30"><Image Source="{Binding AvatarUrl}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Nickname}" FontWeight="SemiBold"/><TextBlock Text="Steam" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="CS2" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding Cs2Rub, StringFormat={}{0:N0} ₽}" Foreground="#C8CDD3" FontSize="11" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="Dota 2" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding DotaRub, StringFormat={}{0:N0} ₽}" Foreground="#C8CDD3" FontSize="11" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Text="Rust" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding RustRub, StringFormat={}{0:N0} ₽}" Foreground="#C8CDD3" FontSize="11" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="Всего" Style="{StaticResource SmallLabel}" HorizontalAlignment="Right"/><TextBlock Text="{Binding TotalRub, StringFormat={}{0:N0} ₽}" Foreground="{StaticResource AccentLightBrush}" FontWeight="Bold" FontSize="15" Margin="0,2,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
