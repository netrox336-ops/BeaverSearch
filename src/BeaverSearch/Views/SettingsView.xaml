<UserControl x:Class="BeaverSearch.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             PreviewMouseWheel="Page_PreviewMouseWheel">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <Grid Margin="24,12,24,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,16"><StackPanel Orientation="Horizontal"><Border Width="4" Height="31" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,3,16,0"/><TextBlock Style="{StaticResource PageTitle}" Text="Настройки"/></StackPanel><TextBlock Style="{StaticResource PageSubtitle}" Margin="20,2,0,0" Text="Поведение приложения, источники yooma.su / CYBERSHOKE и внешний вид"/></StackPanel>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.12*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" MinHeight="398"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="M12,8 A4,4 0 1 1 11.99,8 M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1" Style="{StaticResource AccentLineIcon}" Width="20" Height="20" Margin="0,0,9,0"/><TextBlock Style="{StaticResource SectionTitle}" Text="Общие"/></StackPanel><Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Язык интерфейса" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" SelectedValue="{Binding Settings.Language}" SelectedValuePath="Tag"><ComboBoxItem Content="🇷🇺  Русский" Tag="Русский"/></ComboBox></Grid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Запуск приложения" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/><Border Grid.Column="1" Background="#101316" BorderBrush="#343A42" BorderThickness="1" CornerRadius="6" MinHeight="40"><TextBlock Text="Показывать главное окно" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" Margin="11,0"/></Border></Grid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Сворачивать в трей" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="False" IsEnabled="False"/><TextBlock Text="Скоро" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="9,4,0,0"/></StackPanel></Grid><TextBlock Text="Тема оформления" Foreground="{StaticResource Text2Brush}" Margin="0,22,0,8"/><StackPanel Orientation="Horizontal"><Border Width="94" Height="62" Background="#101315" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="7" Margin="0,0,10,0"><Grid><Border Background="#1B1E22" Margin="10" CornerRadius="4"/><Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"/></Grid></Border><Border Width="94" Height="62" Background="#1A1D21" BorderBrush="#343A42" BorderThickness="1" CornerRadius="7" Margin="0,0,10,0"><Grid><Border Background="#E7E9EB" Margin="10,10,10,28" CornerRadius="3"/><Border Background="#24272B" Margin="10,36,10,10" CornerRadius="3"/></Grid></Border><Border Width="94" Height="62" Background="#F1F1F1" BorderBrush="#343A42" BorderThickness="1" CornerRadius="7"><Border Background="#FFFFFF" Margin="10" CornerRadius="4"/></Border></StackPanel><TextBlock Text="●  Тёмная" Foreground="{StaticResource AccentHoverBrush}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" MinHeight="398"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="M10,3 A7,7 0 1 1 9.99,3 M15,15 L21,21" Style="{StaticResource AccentLineIcon}" Width="20" Height="20" Margin="0,0,9,0"/><TextBlock Style="{StaticResource SectionTitle}" Text="Сканирование"/></StackPanel><Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><TextBlock Text="Интервал опроса серверов" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Settings.PollSeconds, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/></Grid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><TextBlock Text="Таймаут запроса" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Settings.RequestTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/></Grid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><TextBlock Text="Пауза для повторной проверки" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" VerticalAlignment="Center"/><Border Grid.Column="1" Background="#101316" BorderBrush="#343A42" BorderThickness="1" CornerRadius="6" MinHeight="40"><TextBlock Text="24 часа" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><TextBlock Text="Одновременных сканов" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/><Border Grid.Column="1" Background="#101316" BorderBrush="#343A42" BorderThickness="1" CornerRadius="6" MinHeight="40"><TextBlock Text="{Binding ScanParallelism, StringFormat={}{0} потоков}" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><Border Style="{StaticResource InnerCard}" Margin="0,20,0,0"><TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="18" Text="Игрок с подтверждённым SteamID не проверяется повторно в течение 24 часов. Новые игроки обрабатываются сразу после появления на сервере."/></Border></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource Card}" MinHeight="458"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="M8,12 L5,15 C3,17 3,20 5,22 C7,24 10,24 12,22 L16,18 M16,12 L19,9 C21,7 21,4 19,2 C17,0 14,0 12,2 L8,6 M9,15 L15,9" Style="{StaticResource AccentLineIcon}" Width="20" Height="20" Margin="0,0,9,0"/><TextBlock Style="{StaticResource SectionTitle}" Text="Провайдеры"/></StackPanel><Border Style="{StaticResource InnerCard}" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="18" Background="#29231D"><TextBlock Text="Y" Foreground="{StaticResource AccentHoverBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="yooma.su" FontWeight="SemiBold"/><TextBlock Text="Live DOM → точный SteamID64" Style="{StaticResource SmallLabel}"/></StackPanel><TextBlock Grid.Column="2" Text="● Активен" Foreground="{StaticResource SuccessBrush}" FontSize="11" VerticalAlignment="Center"/></Grid></Border><Border Style="{StaticResource InnerCard}" Margin="0,9,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="18" Background="#171D24"><TextBlock Text="C" Foreground="#8EC5FF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="CYBERSHOKE" FontWeight="SemiBold"/><TextBlock Text="Live DOM/state → точный SteamID64" Style="{StaticResource SmallLabel}"/></StackPanel><TextBlock Grid.Column="2" Text="● Активен" Foreground="{StaticResource SuccessBrush}" FontSize="11" VerticalAlignment="Center"/></Grid></Border><Border Style="{StaticResource InnerCard}" Margin="0,9,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="18" Background="#1687D9"><TextBlock Text="S" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Skinport" FontWeight="SemiBold"/><TextBlock Text="Цены CS2 / Dota 2 / Rust" Style="{StaticResource SmallLabel}"/></StackPanel><TextBlock Grid.Column="2" Text="● Активен" Foreground="{StaticResource SuccessBrush}" FontSize="11" VerticalAlignment="Center"/></Grid></Border><Border Style="{StaticResource InnerCard}" Margin="0,9,0,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="7" Background="#292D32"><TextBlock Text="f" Foreground="#E8EAED" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="CSFloat" FontWeight="SemiBold"/><TextBlock Text="Advanced CS2 valuation" Style="{StaticResource SmallLabel}"/></StackPanel><TextBlock Grid.Column="2" Text="API ключ" Style="{StaticResource SmallLabel}" VerticalAlignment="Center"/></Grid><TextBox Text="{Binding Settings.CsFloatApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,9,0,0" Tag="CSFloat API key (необязательно)"/></StackPanel></Border><TextBlock Text="API-ключи хранятся только локально на этом компьютере." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
            </Grid>
            <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.78*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" MinHeight="286"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="M3,4 L21,4 L14,12 L14,20 L10,22 L10,12 Z" Style="{StaticResource AccentLineIcon}" Width="19" Height="19" Margin="0,0,9,0"/><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Фильтры по умолчанию"/><TextBlock Text="Базовые ценовые диапазоны для поиска игроков" Style="{StaticResource SmallLabel}"/></StackPanel></StackPanel><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image Source="/Assets/Games/cs2.png" Width="34" Height="34"/><TextBlock Text="CS2" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="9,6,0,0"/></StackPanel><TextBox Grid.Column="1" Text="{Binding Settings.Cs2Min, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="—" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><TextBox Grid.Column="3" Text="{Binding Settings.Cs2Max, UpdateSourceTrigger=PropertyChanged}"/></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image Source="/Assets/Games/dota2.png" Width="34" Height="34"/><TextBlock Text="Dota 2" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="9,6,0,0"/></StackPanel><TextBox Grid.Column="1" Text="{Binding Settings.DotaMin, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="—" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><TextBox Grid.Column="3" Text="{Binding Settings.DotaMax, UpdateSourceTrigger=PropertyChanged}"/></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image Source="/Assets/Games/rust.png" Width="34" Height="34"/><TextBlock Text="Rust" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="9,6,0,0"/></StackPanel><TextBox Grid.Column="1" Text="{Binding Settings.RustMin, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="—" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><TextBox Grid.Column="3" Text="{Binding Settings.RustMax, UpdateSourceTrigger=PropertyChanged}"/></Grid></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" MinHeight="286"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="M4,6 L20,6 L20,20 L4,20 Z M7,10 L17,10 M7,14 L17,14 M7,18 L13,18" Style="{StaticResource AccentLineIcon}" Width="19" Height="19" Margin="0,0,9,0"/><TextBlock Style="{StaticResource SectionTitle}" Text="Данные"/></StackPanel><TextBlock Text="Путь к кэшу" Style="{StaticResource SmallLabel}" Margin="0,18,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><Border Background="#101316" BorderBrush="#343A42" BorderThickness="1" CornerRadius="6" Padding="10"><TextBlock Text="{Binding DataFolder}" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis"/></Border><Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding OpenDataFolderCommand}" ToolTip="Открыть папку"><Path Data="M3,6 L10,6 L12,8 L21,8 L21,20 L3,20 Z" Style="{StaticResource LineIcon}" Width="17" Height="17"/></Button></Grid><TextBlock Text="Размер / записи кэша" Style="{StaticResource SmallLabel}" Margin="0,14,0,5"/><TextBlock Text="{Binding CacheRecordCount, StringFormat={}{0} записей}" FontSize="17" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenDataFolderCommand}" Content="Открыть папку" Margin="0,0,8,0"/><Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearCacheCommand}" Content="Очистить кэш"/></StackPanel></StackPanel></Border><Border Grid.Column="4" Style="{StaticResource Card}" MinHeight="286"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="M12,3 A9,9 0 1 1 11.99,3 M12,10 L12,17 M12,7 L12,7" Style="{StaticResource AccentLineIcon}" Width="19" Height="19" Margin="0,0,9,0"/><TextBlock Style="{StaticResource SectionTitle}" Text="О программе"/></StackPanel><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="/Assets/Brand/beaver_logo.png" Width="74" Height="74"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="23" FontWeight="Bold"><Run Text="Beaver" Foreground="{StaticResource AccentHoverBrush}"/><Run Text="Search" Foreground="#D6DCE2"/></TextBlock><TextBlock Text="Версия 0.4.1 FixSteamID" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Grid><TextBlock Text="BeaverSearch — инструмент для мониторинга игроков на игровых серверах и оценки публичных Steam-инвентарей." Foreground="#B0B7BF" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,14,0,0"/><TextBlock Text="БОЛЬШЕ ЧЕМ ПОИСК" Foreground="#A77D52" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,0"/></StackPanel></Border></Grid>
            <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Изменения сохраняются автоматически; кнопка справа повторно фиксирует settings / servers / cache." Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" Content="✓  Сохранить всё" MinWidth="150"/></Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
