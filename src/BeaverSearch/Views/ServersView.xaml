<UserControl x:Class="BeaverSearch.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             PreviewMouseWheel="Page_PreviewMouseWheel">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <Grid Margin="24,12,24,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Border Width="4" Height="31" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,3,16,0"/><TextBlock Style="{StaticResource PageTitle}" Text="Серверы yooma.su + CYBERSHOKE"/></StackPanel><TextBlock Style="{StaticResource PageSubtitle}" Margin="20,2,0,0" Text="Каталог формируется автоматически из live DOM yooma.su и CYBERSHOKE. Ручное добавление серверов для resolver не требуется."/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource Text2Brush}" FontSize="11" HorizontalAlignment="Right"/><TextBlock Text="Источники: yooma.su + CYBERSHOKE" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel></Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition MinHeight="360"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Style="{StaticResource IconTile}" Width="42" Height="42" Margin="0,0,12,0"><TextBlock Text="Y+C" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Авто-каталог community servers" FontWeight="SemiBold"/><TextBlock Text="Live DOM двух проектов обновляется автоматически; CYBERSHOKE режимы обходятся rolling-batch" Style="{StaticResource SmallLabel}" Margin="0,3,0,0"/></StackPanel></StackPanel><TextBox x:Name="ServerSearchBox" Grid.Column="1" VerticalAlignment="Center" Tag="Поиск по серверам…" TextChanged="ServerSearchBox_TextChanged"/></Grid><DataGrid x:Name="ServersGrid" Grid.Row="1" ItemsSource="{Binding Servers}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Сервер / ключ" Binding="{Binding Address}" Width="1.2*"/><DataGridTemplateColumn Header="Название" Width="1.55*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="/Assets/Games/cs2.png" Width="23" Height="23" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Карта" Binding="{Binding Map}" Width="1*"/><DataGridTemplateColumn Header="Статус" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,7,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource DangerBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Online}" Value="True"><Setter Property="Fill" Value="{StaticResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding Status}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Игроков" Binding="{Binding PlayerCountText}" Width="86"/><DataGridTextColumn Header="Проверка" Binding="{Binding LastCheckText}" Width="94"/><DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="155"/></DataGrid.Columns></DataGrid></Grid></Border>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" MinHeight="245"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="M8,12 L5,15 C3,17 3,20 5,22 C7,24 10,24 12,22 L16,18 M16,12 L19,9 C21,7 21,4 19,2 C17,0 14,0 12,2 L8,6 M9,15 L15,9" Style="{StaticResource AccentLineIcon}" Width="19" Height="19" Margin="0,0,10,0"/><TextBlock Style="{StaticResource SectionTitle}" Text="Как определяется игрок"/></StackPanel><Border Style="{StaticResource InnerCard}" Margin="0,18,0,0"><StackPanel><TextBlock Text="1. Live DOM мониторинга" FontWeight="SemiBold"/><TextBlock Text="BeaverSearch сначала читает HTML, а для SPA запускает Edge/Chrome headless и получает DOM после JavaScript." Style="{StaticResource SmallLabel}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource InnerCard}" Margin="0,9,0,0"><StackPanel><TextBlock Text="2. SteamID64 из элемента сайта" FontWeight="SemiBold"/><TextBlock Text="SteamID берётся из profile URL, data-steamid/steamId или player state. Сопоставление по нику не используется." Style="{StaticResource SmallLabel}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource InnerCard}" Margin="0,9,0,0"><StackPanel><TextBlock Text="3. Inventory Scanner" FontWeight="SemiBold"/><TextBlock Text="Подтверждённый SteamID сразу передаётся в существующий Steam profile / inventory / price pipeline." Style="{StaticResource SmallLabel}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" MinHeight="245"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="M3,4 L21,4 L21,9 L3,9 Z M3,11 L21,11 L21,16 L3,16 Z M3,18 L21,18 L21,23 L3,23 Z" Style="{StaticResource AccentLineIcon}" Width="19" Height="19" Margin="0,0,10,0"/><TextBlock Style="{StaticResource SectionTitle}" Text="Источники мониторинга"/></StackPanel><Border Style="{StaticResource InnerCard}" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><Border Width="38" MinHeight="40" CornerRadius="8" Background="#29231D"><TextBlock Text="Y" Foreground="{StaticResource AccentHoverBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="yooma.su" FontWeight="SemiBold"/><TextBlock Text="  ● Активен" Foreground="{StaticResource SuccessBrush}" FontSize="10" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Live DOM + профиль / data SteamID64" Style="{StaticResource SmallLabel}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="Режим" Style="{StaticResource SmallLabel}"/><TextBlock Text="HTTP+DOM" Foreground="{StaticResource SuccessBrush}" Margin="0,3,0,0"/></StackPanel></Grid></Border><Border Style="{StaticResource InnerCard}" Margin="0,9,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><Border Width="38" MinHeight="40" CornerRadius="8" Background="#29231D"><TextBlock Text="C" Foreground="{StaticResource AccentHoverBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="CYBERSHOKE" FontWeight="SemiBold"/><TextBlock Text="  ● Активен" Foreground="{StaticResource SuccessBrush}" FontSize="10" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Mode pages + rendered player state with SteamID64" Style="{StaticResource SmallLabel}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="Режим" Style="{StaticResource SmallLabel}"/><TextBlock Text="Rolling DOM" Foreground="{StaticResource SuccessBrush}" Margin="0,3,0,0"/></StackPanel></Grid></Border><Border Style="{StaticResource InnerCard}" Margin="0,9,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><Border Width="38" MinHeight="40" CornerRadius="8" Background="#22262B"><Path Data="M4,12 C4,7 8,4 12,4 C16,4 20,7 20,12 C20,17 16,20 12,20 C8,20 4,17 4,12 Z M7,12 L17,12 M12,7 L12,17" Style="{StaticResource LineIcon}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="Локальный cache" FontWeight="SemiBold"/><TextBlock Text="  ● Активен" Foreground="{StaticResource SuccessBrush}" FontSize="10" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Один SteamID не сканируется повторно 24 часа" Style="{StaticResource SmallLabel}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="TTL" Style="{StaticResource SmallLabel}"/><TextBlock Text="24 часа" Foreground="{StaticResource SuccessBrush}" Margin="0,3,0,0"/></StackPanel></Grid></Border></StackPanel></Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
