<UserControl x:Class="BeaverSearch.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" PreviewMouseWheel="Page_PreviewMouseWheel">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <Grid Margin="24,12,24,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><StackPanel Orientation="Horizontal"><Border Width="4" Height="31" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,3,16,0"/><TextBlock Style="{StaticResource PageTitle}" Text="Диагностика"/></StackPanel><TextBlock Style="{StaticResource PageSubtitle}" Margin="20,2,0,0" Text="Диагностика yooma.su + CYBERSHOKE, SteamID64 и обработки инвентарей"/></StackPanel>
                <Border Grid.Column="1" Style="{StaticResource StatusChip}" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding MonitoringStateText}" Foreground="#72E8AA" FontWeight="SemiBold" FontSize="12"/></StackPanel></Border>
                <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource Text2Brush}" FontSize="11" HorizontalAlignment="Right"/><TextBlock Text="yooma.su + CYBERSHOKE / DOM / inventory" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
            </Grid>
            <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" MinHeight="94" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><TextBlock Text="Y" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="yooma.su" FontWeight="SemiBold"/><TextBlock Text="{Binding YoomaHealthText}" Foreground="{StaticResource SuccessBrush}" FontSize="10" Margin="0,3,0,0"/><TextBlock Text="HTTP + JS DOM" Style="{StaticResource SmallLabel}" Margin="0,2,0,0"/></StackPanel></Grid></Border>
                <Border Style="{StaticResource Card}" MinHeight="94" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><TextBlock Text="C" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="CYBERSHOKE" FontWeight="SemiBold"/><TextBlock Text="{Binding CybershokeHealthText}" Foreground="{StaticResource SuccessBrush}" FontSize="10" Margin="0,3,0,0"/><TextBlock Text="rolling JS DOM" Style="{StaticResource SmallLabel}" Margin="0,2,0,0"/></StackPanel></Grid></Border>
                <Border Style="{StaticResource Card}" MinHeight="94" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><Path Data="M8,12 L5,15 C3,17 3,20 5,22 C7,24 10,24 12,22 L16,18 M16,12 L19,9 C21,7 21,4 19,2 C17,0 14,0 12,2 L8,6 M9,15 L15,9" Style="{StaticResource AccentLineIcon}" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="SteamID из DOM" FontWeight="SemiBold"/><TextBlock Text="{Binding CommunityProfilePlayers, StringFormat='Найдено: {0}'}" Foreground="{StaticResource SuccessBrush}" FontSize="10" Margin="0,3,0,0"/><TextBlock Text="без поиска по нику" Style="{StaticResource SmallLabel}" Margin="0,2,0,0"/></StackPanel></Grid></Border>
                <Border Style="{StaticResource Card}" MinHeight="94" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><Path Data="M4,8 C4,5 8,3 12,3 C16,3 20,5 20,8 C20,11 16,13 12,13 C8,13 4,11 4,8 Z M4,8 L4,16 C4,19 8,21 12,21 C16,21 20,19 20,16 L20,8" Style="{StaticResource AccentLineIcon}" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="API цены" FontWeight="SemiBold"/><TextBlock Text="{Binding PriceHealthText}" Foreground="{StaticResource SuccessBrush}" FontSize="10" Margin="0,3,0,0"/><TextBlock Text="Skinport / CSFloat" Style="{StaticResource SmallLabel}" Margin="0,2,0,0"/></StackPanel></Grid></Border>
                <Border Style="{StaticResource Card}" MinHeight="94" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><Path Data="M5,7 L19,7 L19,20 L5,20 Z M8,4 L16,4 L16,7 M9,11 L15,11 M9,15 L15,15" Style="{StaticResource AccentLineIcon}" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Инвентари" FontWeight="SemiBold"/><TextBlock Text="{Binding InventoryHealthText}" Foreground="{StaticResource SuccessBrush}" FontSize="10" Margin="0,3,0,0"/><TextBlock Text="До 8 параллельно" Style="{StaticResource SmallLabel}" Margin="0,2,0,0"/></StackPanel></Grid></Border>
                <Border Style="{StaticResource Card}" MinHeight="94"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><Path Data="M4,6 L20,6 L20,20 L4,20 Z M7,10 L17,10 M7,14 L17,14 M7,18 L13,18" Style="{StaticResource AccentLineIcon}" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Кэш системы" FontWeight="SemiBold"/><TextBlock Text="{Binding CacheHealthText}" Foreground="{StaticResource SuccessBrush}" FontSize="10" Margin="0,3,0,0"/><TextBlock Text="{Binding CacheRecordCount, StringFormat='Записей: {0}'}" Style="{StaticResource SmallLabel}" Margin="0,2,0,0"/></StackPanel></Grid></Border>
            </UniformGrid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource Card}" Padding="0" MinHeight="310">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition MinHeight="250" Height="Auto"/></Grid.RowDefinitions><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M8,11 A4,4 0 1 1 8,3 A4,4 0 1 1 8,11 M2,21 C2,16 5,13 9,13 C13,13 16,16 16,21" Style="{StaticResource AccentLineIcon}" Width="19" Height="19" Margin="0,0,10,0"/><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Поток игроков"/><TextBlock Text="Последние обнаруженные и обработанные игроки" Style="{StaticResource SmallLabel}"/></StackPanel></StackPanel><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Все серверы" MinWidth="110"/></Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding LivePlayers}" IsReadOnly="True" MinHeight="250"><DataGrid.Columns><DataGridTextColumn Header="Ник" Binding="{Binding Nickname}" Width="1.15*"/><DataGridTextColumn Header="Сервер" Binding="{Binding Server}" Width="1*"/><DataGridTextColumn Header="SteamID64" Binding="{Binding SteamId64}" Width="150"/><DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="1.35*"/><DataGridTextColumn Header="Событие" Binding="{Binding LastSeenText}" Width="92"/></DataGrid.Columns></DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource Card}" MinHeight="310"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="M10,3 A7,7 0 1 1 9.99,3 M15,15 L21,21" Style="{StaticResource AccentLineIcon}" Width="20" Height="20" Margin="0,0,10,0"/><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Проверка SteamID вручную"/><TextBlock Text="Проверка профиля и трёх инвентарей" Style="{StaticResource SmallLabel}"/></StackPanel></StackPanel><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><TextBox Text="{Binding ManualSteamId, UpdateSourceTrigger=PropertyChanged}" Tag="SteamID64"/><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding ManualCheckCommand}" Content="Проверить"/></Grid><Border Style="{StaticResource InnerCard}" Margin="0,14,0,0" MinHeight="155"><TextBlock Text="{Binding ManualResultText}" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" LineHeight="20"/></Border></StackPanel></Border>
                <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource Card}" Padding="0" MinHeight="340"><Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition MinHeight="280" Height="Auto"/></Grid.RowDefinitions><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M5,4 L19,4 L19,21 L5,21 Z M8,8 L16,8 M8,12 L16,12 M8,16 L14,16" Style="{StaticResource AccentLineIcon}" Width="19" Height="19" Margin="0,0,10,0"/><TextBlock Style="{StaticResource SectionTitle}" Text="Журнал событий"/></StackPanel><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding ClearCacheCommand}" Content="Очистить кэш"/></Grid><ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Style="{StaticResource CleanListBox}" Foreground="#BBC2CA" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Padding="14,4"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="4,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#242A30"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style></ListBox.ItemContainerStyle></ListBox></Grid></Border>
                <StackPanel Grid.Column="2" Grid.Row="2">
                    <Border Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="M4,20 L4,13 L7,13 L7,20 Z M10,20 L10,8 L13,8 L13,20 Z M16,20 L16,4 L19,4 L19,20 Z" Style="{StaticResource AccentLineIcon}" Width="20" Height="20" Margin="0,0,10,0"/><TextBlock Style="{StaticResource SectionTitle}" Text="Статистика resolver и обработки"/></StackPanel><UniformGrid Columns="2" Rows="4" Margin="0,16,0,0"><Border Style="{StaticResource InnerCard}" Margin="0,0,8,8"><StackPanel><TextBlock Text="yooma live SteamID" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding YoomaProfilePlayers}" FontSize="23" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource InnerCard}" Margin="8,0,0,8"><StackPanel><TextBlock Text="CYBERSHOKE live SteamID" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding CybershokeProfilePlayers}" FontSize="23" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource InnerCard}" Margin="0,0,8,8"><StackPanel><TextBlock Text="yooma DOM players" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding YoomaLivePlayers}" FontSize="23" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource InnerCard}" Margin="8,0,0,8"><StackPanel><TextBlock Text="CYBERSHOKE DOM players" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding CybershokeLivePlayers}" FontSize="23" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource InnerCard}" Margin="0,0,8,8"><StackPanel><TextBlock Text="SteamID confirmed" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding ConfirmedSteamIds}" Foreground="{StaticResource SuccessBrush}" FontSize="23" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource InnerCard}" Margin="8,0,0,8"><StackPanel><TextBlock Text="Unresolved" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding UnresolvedSession}" Foreground="{StaticResource WarningBrush}" FontSize="23" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource InnerCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Inventory processing" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding ProcessingCount}" FontSize="23" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource InnerCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Совпадения" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding MatchCount}" Foreground="{StaticResource SuccessBrush}" FontSize="23" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border></UniformGrid></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="M3,12 A9,9 0 0 1 18,5 M18,5 L18,1 M18,5 L14,5 M21,12 A9,9 0 0 1 6,19 M6,19 L6,23 M6,19 L10,19" Style="{StaticResource AccentLineIcon}" Width="19" Height="19" Margin="0,0,10,0"/><TextBlock Style="{StaticResource SectionTitle}" Text="Текущие процессы"/></StackPanel><Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Сканирование инвентарей" Style="{StaticResource SmallLabel}"/><TextBlock Grid.Column="1" Text="{Binding ProcessingCount}" Foreground="{StaticResource Text2Brush}" FontSize="11"/></Grid><ProgressBar Value="{Binding ProcessingCount, Mode=OneWay}" Maximum="{Binding ScanParallelism, Mode=OneWay}" Margin="0,7,0,0"/><Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Страницы yooma.su" Style="{StaticResource SmallLabel}"/><TextBlock Grid.Column="1"><Run Text="{Binding YoomaPagesLoaded, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding YoomaPagesAttempted, Mode=OneWay}"/></TextBlock></Grid><ProgressBar Value="{Binding YoomaPagesLoaded, Mode=OneWay}" Maximum="{Binding YoomaPagesAttempted, Mode=OneWay}" Margin="0,7,0,0"/><Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="CYBERSHOKE batch" Style="{StaticResource SmallLabel}"/><TextBlock Grid.Column="1"><Run Text="{Binding CybershokePagesLoaded, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding CybershokePagesAttempted, Mode=OneWay}"/></TextBlock></Grid><ProgressBar Value="{Binding CybershokePagesLoaded, Mode=OneWay}" Maximum="{Binding CybershokePagesAttempted, Mode=OneWay}" Margin="0,7,0,0"/></StackPanel></Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
